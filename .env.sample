# Copy this file to .env and adjust the values.
# Every variable maps to a placeholder in config.yaml.

# app
APP_NAME='Ayaka Backend'
APP_ENV='development' # development | staging | production

# server
SERVER_PORT='8000'
CORS_ALLOWED_ORIGINS='http://localhost:3000'
SWAGGER_ENABLED='true'

# logging
LOG_LEVEL='debug'
LOG_FORMAT='text' # json in staging/production

# database
DATABASE_HOST='localhost'
DATABASE_PORT='5432'
DATABASE_USER='postgres'
DATABASE_PASS='password'
DATABASE_NAME='ayaka_db'
DATABASE_SSLMODE='disable'
DATABASE_TIMEZONE='UTC'

# jwt (required). Use at least 32 random characters outside development:
#   openssl rand -base64 48
JWT_ACCESS_SECRET='change-me-access-secret-at-least-32-chars'
JWT_ACCESS_EXPIRED='15m'
JWT_REFRESH_SECRET='change-me-refresh-secret-at-least-32-chars'
JWT_REFRESH_EXPIRED='168h'

# rate limit for /auth endpoints (per client IP)
RATE_LIMIT_AUTH_MAX='10'
RATE_LIMIT_AUTH_WINDOW='1m'

# frontend
FRONTEND_URL='http://localhost:3000'

# smtp
SMTP_HOST='smtp.gmail.com'
SMTP_PORT='587'
SMTP_USER='your@mail.com'
SMTP_PASS='YOURPASSWORD'
SMTP_FROM='Ayaka <your@mail.com>'

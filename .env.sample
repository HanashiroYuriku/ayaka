# Copy this file to .env and adjust the values.
# Every variable maps to a placeholder in config.yaml.

# app
APP_NAME='Ayaka Backend'
APP_ENV='development' # development | staging | production

# server
SERVER_PORT='8000'
CORS_ALLOWED_ORIGINS='http://localhost:3000'
SWAGGER_ENABLED='true'

# logging
LOG_LEVEL='debug'
LOG_FORMAT='text' # json in staging/production

# database
DATABASE_HOST='localhost'
DATABASE_PORT='5432'
DATABASE_USER='postgres'
DATABASE_PASS='password'
DATABASE_NAME='ayaka_db'
DATABASE_SSLMODE='disable'
DATABASE_TIMEZONE='UTC'

# jwt (required). Use at least 32 random characters outside development:
#   openssl rand -base64 48
JWT_ACCESS_SECRET='change-me-access-secret-at-least-32-chars'
JWT_ACCESS_EXPIRED='15m'

# auth / sessions
AUTH_REFRESH_TTL='168h'
AUTH_REQUIRE_EMAIL_VERIFICATION='true'
AUTH_MAX_FAILED_LOGINS='5'
AUTH_LOCKOUT_DURATION='15m'
AUTH_PASSWORD_RESET_TTL='30m'
AUTH_EMAIL_VERIFICATION_TTL='24h'
AUTH_EMAIL_COOLDOWN='60s'

# rate limit for /auth endpoints (per client IP)
RATE_LIMIT_AUTH_MAX='10'
RATE_LIMIT_AUTH_WINDOW='1m'

# frontend (links in emails point to these pages)
FRONTEND_URL='http://localhost:3000'
FRONTEND_RESET_PASSWORD_PATH='/reset-password'
FRONTEND_VERIFY_EMAIL_PATH='/verify-email'

# email: 'log' prints emails (incl. links) to the log - development only. Use 'smtp' elsewhere.
EMAIL_DRIVER='log'
SMTP_HOST='smtp.gmail.com'
SMTP_PORT='587'
SMTP_USER='your@mail.com'
SMTP_PASS='YOURPASSWORD'
SMTP_FROM='Ayaka <your@mail.com>'
